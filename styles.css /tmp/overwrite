:root {
  --bg: #040b13;
  --bg-2: #0b1320;
  --panel: rgba(14, 20, 28, 0.72);
  --panel-strong: rgba(12, 18, 26, 0.92);
  --panel-soft: rgba(255, 255, 255, 0.04);
  --card: rgba(255, 255, 255, 0.04);
  --stroke: rgba(255, 255, 255, 0.12);
  --stroke-soft: rgba(255, 255, 255, 0.08);
  --text: #eef6ff;
  --muted: #9bb4cc;
  --blue: #7bd7ff;
  --blue-deep: #5aa8ff;
  --green: #7ce6ad;
  --pink: #ff8ec7;
  --amber: #ffc772;
  --shadow: rgba(7, 12, 20, 0.48);
  --font-ui: "Segoe UI", "Inter", sans-serif;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-height: 100vh;
  font-family: var(--font-ui);
  background:
    radial-gradient(circle at top left, rgba(88, 128, 255, 0.12), transparent 30%),
    radial-gradient(circle at bottom right, rgba(120, 236, 255, 0.12), transparent 24%),
    linear-gradient(135deg, #020814 0%, #07121d 28%, #0f1d2a 100%);
  color: var(--text);
  transition: background 0.25s ease, color 0.25s ease;
  overflow-x: hidden;
}
