.window-stack {
  width: min(920px, 100%);
  margin: 28px auto 0;
  overflow: hidden;
}

.desktop-window {
  width: min(920px, 100%);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 22px;
  background: linear-gradient(180deg, rgba(17, 22, 30, 0.96), rgba(9, 14, 21, 0.98));
  box-shadow: 0 28px 60px rgba(2, 6, 23, 0.48);
  overflow: hidden;
  opacity: 1;
  max-height: 700px;
  transform: translateY(0);
  transition: opacity 0.25s ease, max-height 0.25s ease, transform 0.25s ease, border-width 0.25s ease, margin 0.25s ease;
}

.desktop-window:not(.is-open) {
  opacity: 0;
  max-height: 0;
  border-width: 0;
  transform: translateY(-8px);
  margin: 0;
  pointer-events: none;
}

.window-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 14px 18px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  background: rgba(255, 255, 255, 0.02);
}

.window-title-group {
  display: flex;
  align-items: center;
  gap: 10px;
}

.traffic-light {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  display: inline-block;
}

.traffic-light.red { background: #ff7d7d; }
.traffic-light.yellow { background: #ffcf6b; }
.traffic-light.green { background: #7ee7a1; }

.window-title {
  margin-left: 8px;
  font-size: 0.82rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--muted);
}

.window-actions {
  display: flex;
  align-items: center;
  gap: 12px;
  color: var(--muted);
  font-size: 0.9rem;
}

.window-body {
  display: grid;
  grid-template-columns: 220px 1fr;
  min-height: 300px;
}

.window-sidebar {
  padding: 18px 14px;
  border-right: 1px solid rgba(255, 255, 255, 0.08);
  background: rgba(255, 255, 255, 0.01);
}

.nav-group + .nav-group {
  margin-top: 20px;
}

.nav-group p {
  margin: 0 0 10px;
  color: var(--muted);
  font-size: 0.68rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.nav-group ul {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: 8px;
}

.nav-item {
  padding: 9px 10px;
  border-radius: 10px;
  color: #dfeaf9;
  background: transparent;
  font-size: 0.8rem;
}

.nav-item.active {
  background: rgba(110, 198, 255, 0.14);
  color: var(--text);
}

.window-content {
  padding: 16px 20px 20px;
}

.toolbar {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 12px;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.02);
  color: var(--muted);
  font-size: 0.76rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 18px;
}

.crumb.current {
  color: var(--text);
}

.file-table {
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 14px;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.01);
}

.file-row {
  display: grid;
  grid-template-columns: 1.7fr 1fr 1fr;
  gap: 16px;
  padding: 12px 14px;
  border-bottom: 1px solid rgba(255,255,255,0.06);
  color: #dfeaf9;
  font-size: 0.82rem;
}

.file-row:last-child {
  border-bottom: 0;
}

.file-header {
  background: rgba(255,255,255,0.03);
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-size: 0.68rem;
}

@media (max-width: 980px) {
  .window-body {
    grid-template-columns: 1fr;
  }

  .window-sidebar {
    border-right: 0;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }
}
