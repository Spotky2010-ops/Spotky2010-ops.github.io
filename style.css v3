.window-stack {
  width: min(940px, 100%);
  margin: 28px auto 0;
  position: relative;
}

.desktop-window {
  position: relative;
  width: min(940px, 100%);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 22px;
  background: linear-gradient(180deg, rgba(16, 22, 31, 0.78), rgba(10, 15, 22, 0.88));
  box-shadow:
    0 30px 65px rgba(2, 6, 23, 0.55),
    inset 0 1px 0 rgba(255,255,255,0.08);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  overflow: hidden;
  opacity: 1;
  max-height: 700px;
  transform: translateY(0);
  transition: opacity 0.25s ease, max-height 0.25s ease, transform 0.25s ease, border-width 0.25s ease, margin 0.25s ease;
}

.desktop-window:not(.is-open) {
  opacity: 0;
  max-height: 0;
  border-width: 0;
  transform: translateY(-8px);
  margin: 0;
  pointer-events: none;
}

.window-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 12px 16px;
  background: linear-gradient(180deg, rgba(255,255,255,0.08), rgba(255,255,255,0.02));
  border-bottom: 1px solid rgba(255,255,255,0.08);
}

.window-title-group {
  display: flex;
  align-items: center;
  gap: 14px;
}

.window-chrome {
  display: flex;
  align-items: center;
  gap: 8px;
}

.traffic-light {
  width: 11px;
  height: 11px;
  border-radius: 50%;
  display: block;
}

.traffic-light.red { background: #ff6b6b; }
.traffic-light.yellow { background: #ffce6a; }
.traffic-light.green { background: #74e38b; }

.window-title {
  color: #edf5ff;
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.window-actions {
  display: flex;
  align-items: center;
  gap: 12px;
  color: rgba(228,233,240,0.82);
  font-size: 0.85rem;
}

.window-action {
  width: 18px;
  height: 18px;
  display: grid;
  place-items: center;
  border-radius: 6px;
  transition: background 0.2s ease;
}

.window-action.close {
  color: #fff;
}

.window-action:hover {
  background: rgba(255,255,255,0.06);
}

.window-addressbar {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 14px;
  background: rgba(255,255,255,0.02);
  border-bottom: 1px solid rgba(255,255,255,0.08);
}

.address-label {
  color: rgba(216,225,236,0.7);
  font-size: 0.66rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.address-box {
  flex: 1;
  min-height: 38px;
  display: flex;
  align-items: center;
  padding: 0 14px;
  border-radius: 12px;
  border: 1px solid rgba(255,255,255,0.08);
  background: rgba(14, 20, 28, 0.5);
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);
}

.address-path {
  color: rgba(236, 242, 250, 0.9);
  font-size: 0.82rem;
  letter-spacing: 0.02em;
}

.address-button {
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 10px;
  background: rgba(110,198,255,0.14);
  color: white;
  padding: 8px 14px;
  font-size: 0.76rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.window-body {
  display: grid;
  grid-template-columns: 220px minmax(0, 1fr);
  min-height: 300px;
  background: linear-gradient(180deg, rgba(12, 17, 25, 0.88), rgba(8, 12, 18, 0.95));
}

.window-sidebar {
  padding: 14px 12px 12px;
  border-right: 1px solid rgba(255,255,255,0.08);
  background: rgba(255,255,255,0.02);
}

.nav-panel + .nav-panel {
  margin-top: 18px;
}

.nav-label {
  margin: 0 0 10px;
  color: rgba(214,222,235,0.7);
  font-size: 0.62rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.nav-list {
  margin: 0;
  padding: 0;
  list-style: none;
  display: grid;
  gap: 8px;
}

.nav-item {
  padding: 10px 12px;
  border-radius: 10px;
  color: rgba(224,233,245,0.9);
  font-size: 0.8rem;
  cursor: pointer;
  background: transparent;
  transition: background 0.18s ease, transform 0.18s ease, color 0.18s ease;
}

.nav-item:hover {
  background: rgba(255,255,255,0.05);
  transform: translateX(2px);
}

.nav-item.active {
  background: rgba(110, 198, 255, 0.12);
  color: #f4f9ff;
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.05);
}

.window-main {
  display: grid;
  grid-template-columns: minmax(0, 1.5fr) minmax(220px, 0.55fr);
  gap: 14px;
  padding: 14px;
}

.content-pane {
  min-width: 0;
}

.toolbar {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 12px;
  border-radius: 10px;
  background: rgba(255,255,255,0.03);
  color: rgba(214,222,235,0.8);
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 14px;
}

.crumb.slash {
  opacity: 0.5;
}

.crumb.current {
  color: #eef6ff;
}

.file-list {
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 12px;
  overflow: hidden;
  background: rgba(255,255,255,0.03);
}

.file-row {
  display: grid;
  grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr) minmax(0, 1fr);
  gap: 16px;
  padding: 12px 14px;
  border-bottom: 1px solid rgba(255,255,255,0.06);
  color: rgba(233,239,247,0.92);
  font-size: 0.82rem;
}

.file-row:last-child {
  border-bottom: 0;
}

.file-header {
  background: rgba(255,255,255,0.04);
  color: rgba(212,220,230,0.8);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-size: 0.68rem;
}

.metadata-pane {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.meta-card {
  padding: 14px 12px;
  border-radius: 14px;
  border: 1px solid rgba(255,255,255,0.08);
  background: rgba(255,255,255,0.03);
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);
}

.meta-header {
  color: rgba(236,242,250,0.92);
  font-size: 0.72rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  margin-bottom: 12px;
}

.meta-row {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  padding: 8px 0;
  border-bottom: 1px solid rgba(255,255,255,0.05);
  color: rgba(228,233,240,0.8);
  font-size: 0.75rem;
}

.meta-row:last-child {
  border-bottom: 0;
}

.meta-label {
  color: rgba(203,214,228,0.7);
}

.quick-actions {
  margin: 0;
  padding-left: 18px;
  color: rgba(228,233,240,0.8);
  font-size: 0.75rem;
  line-height: 1.8;
}

.resize-handle {
  position: absolute;
  right: 8px;
  bottom: 8px;
  width: 22px;
  height: 22px;
  opacity: 0.8;
  background:
    linear-gradient(135deg, rgba(255,255,255,0.18) 0%, rgba(255,255,255,0.04) 0%),
    linear-gradient(135deg, rgba(255,255,255,0.15) 0 40%, rgba(255,255,255,0.04) 40% 100%);
  border-radius: 6px;
}

@media (max-width: 980px) {
  .window-body {
    grid-template-columns: 1fr;
  }

  .window-main {
    grid-template-columns: 1fr;
  }

  .window-sidebar {
    border-right: 0;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }
}
